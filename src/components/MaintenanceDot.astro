---
// Maintenance signal (design system §4.1a) — a separate question from crate
// publication. Rendered only where the source content states one; the absence
// of a dot is itself the "no flagged concern" signal.
import { MAINTENANCE_LABELS, type MaintenanceState } from "../data/fork-status";

interface Props {
    state: MaintenanceState;
}

const { state } = Astro.props;
const label = MAINTENANCE_LABELS[state];
const color = state === "needs-maintainer" ? "bg-warning" : "bg-content-muted";
---

<span
    class={`ml-1.5 inline-block h-2 w-2 rounded-full align-[1px] ${color}`}
    role="img"
    title={label}
>
    <span class="sr-only">{label}</span>
</span>
