---
// The Manifest: a community-maintained index of projects shipped downstream of
// GPUI islands. Data lives in src/data/projects.json so "add a project" is a
// one-file change; projects.schema.json validates it in the editor.
import manifest from "../data/projects.json";
import CrateStatusBadge from "./CrateStatusBadge.astro";
import type { CrateStatus, MaintenanceState } from "../data/fork-status";

interface Project {
    name: string;
    category: string;
    subcategory?: string;
    url: string;
    image?: string;
    description: string;
    /** Fork-only: crate publish status, rendered as a badge when present. */
    crateStatus?: CrateStatus;
    crateUrl?: string;
    /** Fork-only: maintenance signal (design system §4.1a). */
    maintenance?: MaintenanceState;
}

const projects = manifest.projects as Project[];

// Display order: category first (in this order), then name.
const CATEGORY_ORDER = ["Apps", "Forks", "Libraries", "Tooling", "Resources"];

const sorted = [...projects].sort((a, b) => {
    const catDiff =
        CATEGORY_ORDER.indexOf(a.category) - CATEGORY_ORDER.indexOf(b.category);
    if (catDiff !== 0) return catDiff;
    return a.name.localeCompare(b.name, undefined, { sensitivity: "base" });
});

const categoryCounts = new Map<string, number>();
for (const project of projects) {
    categoryCounts.set(
        project.category,
        (categoryCounts.get(project.category) ?? 0) + 1,
    );
}

// Subcategory filter chips exist per category that actually has subcategories
// (Apps today: Developer Tools, Productivity, Media, System Utilities,
// Demos & Examples). Rendered dynamically so new categories get chips for free.
interface SubGroup {
    category: string;
    subs: { name: string; count: number; all: boolean }[];
}

const subByCategory = new Map<string, Map<string, number>>();
for (const project of projects) {
    if (!project.subcategory) continue;
    const subs =
        subByCategory.get(project.category) ?? new Map<string, number>();
    subs.set(project.subcategory, (subs.get(project.subcategory) ?? 0) + 1);
    subByCategory.set(project.category, subs);
}

const subcategoryGroups: SubGroup[] = [...subByCategory.entries()]
    .map(([category, subs]) => ({
        category,
        subs: [
            {
                name: "All",
                count: categoryCounts.get(category) ?? 0,
                all: true,
            },
            ...[...subs.entries()].map(([name, count]) => ({
                name,
                count,
                all: false,
            })),
        ],
    }))
    .sort(
        (a, b) =>
            CATEGORY_ORDER.indexOf(a.category) -
            CATEGORY_ORDER.indexOf(b.category),
    );

// Descriptions may contain inline markdown links like [text](url); everything
// else is trusted plain text from our own data file.
const renderInlineMd = (text: string) =>
    text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>');

const total = sorted.length;

// Filter chips: the pressed state is carried entirely by aria-pressed (the
// group class lets the count inside share the state), so the JS never touches
// a class list — styling comes from aria-pressed: variants.
const chipBase =
    "group inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-border-subtle bg-surface px-3 py-1.5 text-small text-content-muted transition-colors hover:border-focus hover:text-content aria-pressed:border-action/35 aria-pressed:bg-action-tint aria-pressed:text-on-action";
const chipCount =
    "font-mono text-[12px] text-content-muted group-aria-pressed:text-on-action";
---

<div class="mb-5">
    <input
        id="manifest-search"
        class="w-full max-w-88 rounded-md border border-border-subtle bg-surface px-3 py-2 font-sans text-sm text-content placeholder:text-content-muted focus:border-focus focus:outline-2 focus:outline-focus focus:outline-offset-0"
        type="search"
        placeholder="Search projects…"
        aria-label="Search projects"
    />
    <div
        class="mt-3 flex flex-wrap gap-2"
        role="group"
        aria-label="Filter by category"
    >
        <button
            type="button"
            class={chipBase}
            data-filter-type="category"
            data-filter-value="all"
            aria-pressed="true"
        >
            All <span class={chipCount}>{total}</span>
        </button>
        {
            CATEGORY_ORDER.filter((category) =>
                categoryCounts.has(category),
            ).map((category) => (
                <button
                    type="button"
                    class={chipBase}
                    data-filter-type="category"
                    data-filter-value={category}
                    aria-pressed="false"
                >
                    {category}{" "}
                    <span class={chipCount}>
                        {categoryCounts.get(category) ?? 0}
                    </span>
                </button>
            ))
        }
    </div>
    <div
        class="mt-3 flex flex-wrap gap-2"
        id="subcategory-filters"
        role="group"
        aria-label="Filter by subcategory"
        hidden
    >
        {
            subcategoryGroups.map((group) =>
                group.subs.map((sub) => (
                    <button
                        type="button"
                        class={chipBase}
                        data-filter-type="subcategory"
                        data-filter-value={sub.all ? "all" : sub.name}
                        data-category-for={group.category}
                        aria-pressed={sub.all ? "true" : "false"}
                    >
                        {sub.name} <span class={chipCount}>{sub.count}</span>
                    </button>
                )),
            )
        }
    </div>
    <p
        class="mt-3 font-mono text-small text-content-muted"
        id="manifest-count"
        aria-live="polite"
    >
        Showing {total} of {total} projects
    </p>
</div>

<div class="table-scroll">
    <table class="min-w-144 max-sm:min-w-0" id="manifest-table">
        <thead>
            <tr>
                <th scope="col" class="w-[24%]">Project</th>
                <th scope="col" class="w-[15%]">Category</th>
                <th scope="col">Description</th>
            </tr>
        </thead>
        <tbody>
            {
                sorted.map((project) => (
                    <tr
                        data-category={project.category}
                        data-subcategory={project.subcategory}
                    >
                        <td data-label="Project">
                            <a
                                class="inline-flex items-center gap-2.5 font-mono text-code font-medium text-content no-underline overflow-wrap-anywhere hover:text-action"
                                href={project.url}
                            >
                                {project.image && (
                                    <img
                                        class="h-5.5 w-5.5 shrink-0 rounded-sm border border-border-subtle bg-border-subtle object-cover"
                                        src={project.image}
                                        alt=""
                                        loading="lazy"
                                        decoding="async"
                                        referrerpolicy="no-referrer"
                                        onerror="this.style.display='none'"
                                    />
                                )}
                                <span>{project.name}</span>
                            </a>
                        </td>
                        <td data-label="Category">
                            <span class="block text-small font-semibold text-content">
                                {project.category}
                            </span>
                            {project.subcategory && (
                                <span class="mt-0.5 block font-mono text-[12px] text-content-muted">
                                    {project.subcategory}
                                </span>
                            )}
                        </td>
                        <td
                            class="text-sm text-content-muted"
                            data-label="Description"
                        >
                            <span
                                set:html={renderInlineMd(project.description)}
                            />
                            {project.crateStatus && (
                                <span class="mt-2 block">
                                    <CrateStatusBadge
                                        status={project.crateStatus}
                                        href={project.crateUrl}
                                    />
                                </span>
                            )}
                        </td>
                    </tr>
                ))
            }
        </tbody>
    </table>
</div>

<p class="mt-6 text-content-muted" id="manifest-empty" hidden>
    No projects match the current filters.
</p>
<p class="table-note">
    The manifest is maintained by hand in <code>src/data/projects.json</code> — add
    a project with a PR against the
    <a href="https://github.com/gpui-archipelago">gpui-archipelago</a> org.
</p>

<script>
    const table = document.querySelector<HTMLTableElement>("#manifest-table")!;
    const rows = Array.from(
        table.querySelectorAll<HTMLTableRowElement>("tbody tr"),
    );
    const total = rows.length;
    const search =
        document.querySelector<HTMLInputElement>("#manifest-search")!;
    const chips = Array.from(
        document.querySelectorAll<HTMLButtonElement>("[data-filter-type]"),
    );
    const subRow = document.querySelector<HTMLElement>("#subcategory-filters");
    const empty = document.querySelector<HTMLElement>("#manifest-empty")!;
    const count = document.querySelector<HTMLElement>("#manifest-count")!;

    const state = { category: "all", subcategory: "all", query: "" };

    const apply = () => {
        let visible = 0;
        for (const row of rows) {
            const matchesCategory =
                state.category === "all" ||
                row.dataset.category === state.category;
            const matchesSubcategory =
                state.subcategory === "all" ||
                (row.dataset.subcategory ?? "") === state.subcategory;
            const matchesQuery =
                state.query === "" ||
                (row.textContent ?? "").toLowerCase().includes(state.query);
            const show = matchesCategory && matchesSubcategory && matchesQuery;
            row.hidden = !show;
            if (show) visible++;
        }
        empty.hidden = visible !== 0;
        count.textContent = `Showing ${visible} of ${total} projects`;
    };

    for (const chip of chips) {
        chip.addEventListener("click", () => {
            const type = chip.dataset.filterType;
            const value = chip.dataset.filterValue ?? "";
            if (type === "category") {
                state.category = value;
                state.subcategory = "all";
                const hasSubs = subRow?.querySelector(
                    `[data-category-for="${value}"]`,
                );
                if (subRow) subRow.hidden = !hasSubs;
                if (subRow) {
                    for (const c of subRow.querySelectorAll<HTMLButtonElement>(
                        '[data-filter-type="subcategory"]',
                    )) {
                        c.setAttribute(
                            "aria-pressed",
                            String(
                                c.dataset.categoryFor === value &&
                                    c.dataset.filterValue === "all",
                            ),
                        );
                    }
                }
            } else {
                state.subcategory = value;
            }
            for (const c of document.querySelectorAll(
                `[data-filter-type="${type}"]`,
            )) {
                c.setAttribute("aria-pressed", String(c === chip));
            }
            apply();
        });
    }

    search.addEventListener("input", () => {
        state.query = search.value.trim().toLowerCase();
        apply();
    });
</script>
