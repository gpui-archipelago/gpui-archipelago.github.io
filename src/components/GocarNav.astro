---
// The Gocar section's chrome: a breadcrumb in the Fork Map's shape
// (`gpui-archipelago / Gocar`, the wordmark linking home), the section's tab
// row, and the crate facts on the right.
//
// It is the section's *own top-level header*: `/gocar/` passes `siteNav={false}`
// to Layout, so a Gocar page wears one bar — this one — instead of the site nav
// stacked over a sub-bar. The site nav itself is unchanged; a section that is
// its own chrome does not wear another section's.
import { GOCAR_CRATE, GOCAR_TABS } from "../data/gocar";

const { pathname } = Astro.url;

/** "/gocar/" is a prefix of every tab, so it matches exactly; the others by
 * prefix (so a future child page keeps the tab lit). */
const isCurrent = (href: string) =>
    href === "/gocar/" ? pathname === "/gocar/" : pathname.startsWith(href);

const tab =
    "rounded-md px-3 py-1.5 text-small font-medium no-underline transition-colors";
---

<header class="sticky top-0 z-10 border-b border-border-divider bg-surface/90 backdrop-blur">
    <div class="mx-auto flex min-h-16 max-w-7xl flex-wrap items-center gap-x-6 gap-y-1 px-6 py-3">
        <p class="m-0 font-mono text-code">
            <a
                class="text-content-muted no-underline hover:text-action"
                href="/"
            >
                gpui-archipelago
            </a>
            <span class="text-content-muted" aria-hidden="true">
                {" "}
                /{" "}
            </span>
            <span class="font-semibold text-content">Gocar</span>
        </p>
        <nav class="flex flex-wrap items-center gap-1" aria-label="Gocar">
            {GOCAR_TABS.map((t) => (
                <a
                    class={`${tab} ${
                        isCurrent(t.href)
                            ? "bg-action-tint text-on-action"
                            : "text-content-muted hover:bg-surface hover:text-action"
                    }`}
                    href={t.href}
                    aria-current={isCurrent(t.href) ? "page" : undefined}
                >
                    {t.label}
                </a>
            ))}
        </nav>
        <p class="m-0 font-mono text-small text-content-muted sm:ml-auto">
            v{GOCAR_CRATE.version}
            <span aria-hidden="true"> · </span>
            <a
                class="text-content-muted hover:text-action"
                href={GOCAR_CRATE.cratesUrl}
            >
                crates.io ↗
            </a>
        </p>
    </div>
</header>
