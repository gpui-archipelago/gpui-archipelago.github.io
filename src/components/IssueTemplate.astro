---
// Issue-template block (design system §4.3): a literal template someone will
// copy, so it's a distinct, labeled, warm-toned component — not a generic
// syntax-highlighted code block.
const template = `## The problem
Written from the perspective of someone who just hit this wall.
What did they try to do, and what went wrong?

## Why it exists upstream
A plain explanation of the Zed priorities or constraints behind
the gap. Give context, don't assign blame.

## How people currently solve it
Known approaches: forks, crates, workarounds, conventions.
For each one: what it solves, what it doesn't, who maintains it.

## What nobody has solved yet
The part that's still genuinely open.

## Common ground opportunity
Optional. A convention, interface, or spec that several forks
could adopt to stay compatible with each other.`;

// Lines starting with "#" are the template's structural markup; the rest is
// guidance text. They get distinct colors (see §4.3). Built as HTML here so
// the newlines survive into the <pre>.
const html = template
    .split("\n")
    .map((line) => {
        const cls = line.startsWith("#")
            ? "text-content font-semibold"
            : "text-content-muted";
        return `<span class="${cls}">${line}\n</span>`;
    })
    .join("");
---

<div>
    <span class="mb-2 block text-small text-content-muted">issue template</span>
    {
        /* Flat warm wash (#FFF8ED) rather than a generic cool "code editor"
        background. */
    }
    <pre
        class="m-0 overflow-x-auto rounded-md border border-border-subtle bg-[#fff8ed] p-5 px-6 font-mono text-code leading-code"><code set:html={html} /></pre>
</div>
