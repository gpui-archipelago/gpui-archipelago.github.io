---
// The mark appears exactly once per page: here, in the header, badge-sized
// next to the wordmark.
import logo from "../assets/logo.png";

const { pathname } = Astro.url;
const isHome = pathname === "/";
const isManifest = pathname.startsWith("/manifest");
const isNews = pathname.startsWith("/news/");
---

<header
    class="sticky top-0 z-10 border-b border-border-subtle bg-surface/90 backdrop-blur"
>
    <div
        class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-6"
    >
        <a
            class="group flex items-center gap-3 text-content no-underline hover:text-content"
            href="/"
        >
            <img
                class="block h-11 w-11 shrink-0 object-contain"
                src={logo.src}
                width={logo.width}
                height={logo.height}
                alt=""
            />
            <span
                class="font-mono text-code font-semibold tracking-tight transition-colors group-hover:text-action"
                >gpui-archipelago<span
                    class="font-sans text-small font-normal text-content-muted"
                >
                    (GPUI-lago)</span
                ></span
            >
        </a>
        {
            /* The toggle is both the `group` for its icons and the `peer` for the
            mobile menu: the menu's visibility is driven entirely by
            aria-expanded, so the JS never manages a second class. */
        }
        <button
            class="group peer hidden h-10 w-10 items-center justify-center rounded-md p-0 text-content hover:bg-ink/6 max-sm:inline-flex"
            type="button"
            id="menu-toggle"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label="Toggle menu"
        >
            <svg
                class="h-6 w-6 group-aria-expanded:hidden"
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
            >
                <line x1="4" y1="7" x2="20" y2="7"></line>
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <line x1="4" y1="17" x2="20" y2="17"></line>
            </svg>
            <svg
                class="hidden h-6 w-6 group-aria-expanded:block"
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
            >
                <line x1="6" y1="6" x2="18" y2="18"></line>
                <line x1="18" y1="6" x2="6" y2="18"></line>
            </svg>
        </button>
        <nav
            id="site-nav"
            class="flex gap-7 max-sm:absolute max-sm:inset-x-0 max-sm:top-full max-sm:flex-col max-sm:gap-0 max-sm:border-b max-sm:border-border-subtle max-sm:bg-surface max-sm:pb-4 max-sm:shadow-[0_12px_24px_rgba(23,77,104,0.08)] max-sm:hidden peer-aria-expanded:max-sm:flex"
            aria-label="Site"
        >
            <a
                class="text-sm text-content-muted no-underline hover:text-content aria-[current=page]:text-action max-sm:px-6 max-sm:py-3 max-sm:text-code"
                href="/"
                aria-current={isHome ? "page" : undefined}>Home</a
            >
            <a
                class="text-sm text-content-muted no-underline hover:text-content aria-[current=page]:text-action max-sm:px-6 max-sm:py-3 max-sm:text-code"
                href="/manifest/"
                aria-current={isManifest ? "page" : undefined}>Manifest</a
            >
            <a
                class="text-sm text-content-muted no-underline hover:text-content aria-[current=page]:text-action max-sm:px-6 max-sm:py-3 max-sm:text-code"
                href="/news/"
                aria-current={isNews ? "page" : undefined}>News</a
            >
            <a
                class="text-sm text-content-muted no-underline hover:text-content max-sm:px-6 max-sm:py-3 max-sm:text-code"
                href="https://github.com/gpui-archipelago">GitHub</a
            >
        </nav>
    </div>
</header>

<script>
    const toggle = document.querySelector("#menu-toggle");
    const nav = document.querySelector("#site-nav");
    if (toggle && nav) {
        const setOpen = (open: boolean) =>
            toggle.setAttribute("aria-expanded", String(open));
        const close = () => setOpen(false);

        toggle.addEventListener("click", () => {
            setOpen(toggle.getAttribute("aria-expanded") !== "true");
        });
        // Close the menu when a link is chosen or when Escape is pressed.
        nav.addEventListener("click", (event) => {
            if (event.target instanceof Element && event.target.closest("a")) {
                close();
            }
        });
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") close();
        });
    }
</script>
