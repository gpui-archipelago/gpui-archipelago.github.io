---
// Two-problem split (design system §4.4): Ecosystem vs Capability as two
// columns of plain prose — no borders, no tint, no icons. Restraint is the
// point: the comparison table is the element that should look most "boxed" on
// the page, so these two sit side by side on whitespace alone.
interface Problem {
    heading: string;
    body: string;
}

interface Props {
    problems: Problem[];
}

const { problems } = Astro.props;
---

<div class="problem-split">
    {
        problems.map((problem) => (
            <div class="problem">
                <h3>{problem.heading}</h3>
                <p>{problem.body}</p>
            </div>
        ))
    }
</div>

<style>
    .problem-split {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-xl);
    }

    .problem h3 {
        margin: 0 0 var(--space-xs);
        font-size: var(--type-h3);
        font-weight: 500;
        line-height: 1.3;
    }

    .problem p {
        margin: 0;
    }

    @media (max-width: 40rem) {
        .problem-split {
            grid-template-columns: 1fr;
            gap: var(--space-lg);
        }
    }
</style>
