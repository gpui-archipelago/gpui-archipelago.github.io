---
// Page header: kicker + display title + meta, plus optional slot content (the
// home hero's blockquote, the Manifest's illustration). The "sand" variant
// paints the warm band used on the Manifest page (the gradient itself lives
// in global.css as .page-header-sand — a bespoke treatment utilities would
// obscure).
interface Props {
    title: string;
    kicker?: string;
    meta?: string;
    /** "sand" paints the Manifest header's warm band. */
    variant?: "plain" | "sand";
}

const { title, kicker, meta, variant = "plain" } = Astro.props;
const isSand = variant === "sand";
const hasKicker = Boolean(kicker || Astro.slots.has("kicker"));
---

<header
    class={`border-b border-border-divider ${
        isSand
            ? "page-header-sand relative overflow-hidden py-12"
            : "pt-16 pb-8"
    }`}
>
    <div class={`content ${isSand ? "relative" : ""}`}>
        {/* The copy clears the illustration's corner on the sand variant. */}
        <div
            class={isSand
                ? "relative z-10 max-w-[calc(100%-12rem)] max-sm:max-w-[calc(100%-8.5rem)]"
                : undefined}
        >
            {
                hasKicker && (
                    <p class="mb-3 font-mono text-small uppercase tracking-[0.08em] text-content-muted">
                        <slot name="kicker">{kicker}</slot>
                    </p>
                )
            }
            <h1
                class="m-0 text-display font-semibold tracking-[-0.01em] leading-[1.2]"
            >
                {title}
            </h1>
            {
                meta && (
                    <p class="mt-2 font-mono text-small text-content-muted">
                        {meta}
                    </p>
                )
            }
        </div>
        <slot />
    </div>
</header>
