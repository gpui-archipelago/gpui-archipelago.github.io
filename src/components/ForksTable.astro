---
// Forks at a glance — data lives here so "add your fork" is a one-file change.
// Star/fork counts are manually maintained; consider fetching from the GitHub
// API at build time if you want them to stay current automatically.

type CrateStatus = "published" | "unpublished" | "pending";

interface Fork {
    name: string;
    url: string;
    stars: number;
    forks: number;
    crateStatus: CrateStatus;
}

const forks: Fork[] = [
    {
        name: "Zed (upstream GPUI)",
        url: "https://github.com/zed-industries/zed",
        stars: 88000,
        forks: 10000,
        crateStatus: "pending",
    },
    {
        name: "gpui-ce",
        url: "https://github.com/gpui-ce/gpui-ce",
        stars: 925,
        forks: 105,
        crateStatus: "pending",
    },
    {
        name: "gpui-unofficial",
        url: "https://github.com/iamnbutler/gpui-unofficial",
        stars: 44,
        forks: 7,
        crateStatus: "published",
    },
    {
        name: "WGPUI",
        url: "https://github.com/Far-Beyond-Pulsar/WGPUI",
        stars: 64,
        forks: 12,
        crateStatus: "unpublished",
    },
    {
        name: "Kael",
        url: "https://github.com/Augani/kael",
        stars: 34,
        forks: 2,
        crateStatus: "published",
    },
];

const crateStatusMeta: Record<CrateStatus, { glyph: string; label: string }> = {
    published: { glyph: "●", label: "Published" },
    unpublished: { glyph: "○", label: "Unpublished" },
    pending: { glyph: "◐", label: "Pending" },
};
---

<div class="table-scroll">
    <table>
        <thead>
            <tr>
                <th scope="col">Fork</th>
                <th scope="col" class="num">Stars</th>
                <th scope="col" class="num">Forks</th>
                <th scope="col">Crate</th>
            </tr>
        </thead>
        <tbody>
            {
                forks.map((fork) => {
                    const meta = crateStatusMeta[fork.crateStatus];
                    return (
                        <tr>
                            <td>
                                <a class="fork-name" href={fork.url}>
                                    {fork.name}
                                </a>
                            </td>
                            <td class="num">
                                {fork.stars.toLocaleString("en-US")}
                            </td>
                            <td class="num">
                                {fork.forks.toLocaleString("en-US")}
                            </td>
                            <td>
                                <span class={`badge badge-${fork.crateStatus}`}>
                                    {meta.glyph} {meta.label}
                                </span>
                            </td>
                        </tr>
                    );
                })
            }
        </tbody>
    </table>
</div>
<p class="table-note">
    Star and fork counts are manually maintained — help keep them current.
</p>

<style>
    .table-scroll {
        overflow-x: auto;
    }

    table {
        width: 100%;
        min-width: 30rem;
        border-collapse: collapse;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius);
        font-size: 15px;
    }

    thead th:first-child {
        border-top-left-radius: 5px;
    }

    thead th:last-child {
        border-top-right-radius: 5px;
    }

    tbody tr:last-child td:first-child {
        border-bottom-left-radius: 5px;
    }

    tbody tr:last-child td:last-child {
        border-bottom-right-radius: 5px;
    }

    th {
        background: rgba(250, 224, 183, 0.4);
        color: var(--gray-600);
        font-size: 13px;
        font-weight: 500;
        text-align: left;
        padding: 10px 16px;
    }

    th.num {
        text-align: right;
    }

    td {
        padding: 12px 16px;
        border-top: 1px solid var(--gray-200);
        vertical-align: middle;
    }

    tbody tr:first-child td {
        border-top: 0;
    }

    .fork-name {
        font-family: var(--font-mono);
        font-size: 15px;
        color: var(--ink);
        text-decoration: none;
    }

    .fork-name:hover {
        color: var(--coral);
        text-decoration: none;
    }

    td.num {
        font-family: var(--font-mono);
        color: var(--gray-600);
        font-variant-numeric: tabular-nums;
        text-align: right;
    }

    .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 500;
        white-space: nowrap;
    }

    .badge-published {
        background: rgba(239, 78, 40, 0.12);
        color: var(--rust);
    }

    .badge-unpublished {
        background: var(--gray-200);
        color: var(--gray-600);
    }

    .badge-pending {
        background: rgba(168, 98, 20, 0.12);
        color: var(--amber);
    }

    .table-note {
        margin: 12px 0 0;
        font-size: 13px;
        color: var(--gray-600);
    }
</style>
