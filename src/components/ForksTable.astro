---
// Forks at a glance — data lives here so "add your fork" is a one-file change.
// Star/fork counts are manually maintained; consider fetching from the GitHub
// API at build time if you want them to stay current automatically.

type CrateStatus = "published" | "unpublished" | "pending" | "outdated";

interface Fork {
    name: string;
    url: string;
    stars?: number;
    forks?: number;
    crateStatus: CrateStatus;
    /** crates.io page for the crate, when one exists (badge becomes a link). */
    crateUrl?: string;
    /** Row carries a footnote marker (see the note under the table). */
    footnote?: boolean;
    /** Marked as the practical path to current upstream crates. */
    mirror?: boolean;
}

const forks: Fork[] = [
    {
        name: "Zed (upstream GPUI)",
        url: "https://github.com/zed-industries/zed",
        stars: 88000,
        forks: 10000,
        crateStatus: "outdated",
        crateUrl: "https://crates.io/crates/gpui",
        footnote: true,
    },
    {
        name: "gpui-ce",
        url: "https://github.com/gpui-ce/gpui-ce",
        stars: 925,
        forks: 105,
        crateStatus: "published",
        crateUrl: "https://crates.io/crates/gpui-ce",
    },
    {
        name: "gpui-unofficial",
        url: "https://github.com/iamnbutler/gpui-unofficial",
        stars: 44,
        forks: 7,
        crateStatus: "published",
        crateUrl: "https://crates.io/crates/gpui-unofficial",
        mirror: true,
    },
    {
        name: "WGPUI",
        url: "https://github.com/Far-Beyond-Pulsar/WGPUI",
        stars: 64,
        forks: 12,
        crateStatus: "unpublished",
    },
    {
        name: "Kael",
        url: "https://github.com/Augani/kael",
        stars: 34,
        forks: 2,
        crateStatus: "published",
        crateUrl: "https://crates.io/crates/kael",
    },
    {
        name: "GPUI Box",
        url: "https://github.com/fran0220/gpui-box",
        crateStatus: "published",
        crateUrl: "https://crates.io/crates/gpui-box",
    },
];

const crateStatusMeta: Record<CrateStatus, { glyph: string; label: string }> = {
    published: { glyph: "●", label: "Published" },
    unpublished: { glyph: "○", label: "Unpublished" },
    pending: { glyph: "◐", label: "Pending" },
    outdated: { glyph: "◑", label: "Outdated" },
};
---

<div class="table-scroll">
    <table>
        <thead>
            <tr>
                <th scope="col">Fork</th>
                <th scope="col" class="num">Stars</th>
                <th scope="col" class="num">Forks</th>
                <th scope="col">Crate</th>
            </tr>
        </thead>
        <tbody>
            {
                forks.map((fork) => {
                    const meta = crateStatusMeta[fork.crateStatus];
                    return (
                        <tr>
                            <td data-label="Fork">
                                <a class="fork-name" href={fork.url}>
                                    {fork.name}
                                </a>
                                {fork.mirror && (
                                    <span class="mirror-tag">
                                        upstream mirror
                                    </span>
                                )}
                            </td>
                            <td class="num" data-label="Stars">
                                {fork.stars?.toLocaleString("en-US") ?? "—"}
                            </td>
                            <td class="num" data-label="Forks">
                                {fork.forks?.toLocaleString("en-US") ?? "—"}
                            </td>
                            <td data-label="Crate">
                                {fork.crateUrl ? (
                                    <a
                                        class={`badge badge-${fork.crateStatus}`}
                                        href={fork.crateUrl}
                                    >
                                        {meta.glyph} {meta.label}
                                        {fork.footnote && (
                                            <sup class="footnote-mark">†</sup>
                                        )}
                                    </a>
                                ) : (
                                    <span
                                        class={`badge badge-${fork.crateStatus}`}
                                    >
                                        {meta.glyph} {meta.label}
                                    </span>
                                )}
                            </td>
                        </tr>
                    );
                })
            }
        </tbody>
    </table>
</div>
<p class="table-footnote">
    † The official <code>gpui</code> crate on crates.io is months behind upstream.
    For current upstream crates, use <a
        href="https://crates.io/crates/gpui-unofficial">gpui-unofficial</a
    > — an automated mirror of upstream Zed.
</p>
<p class="table-note">
    Star and fork counts are manually maintained — help keep them current.
</p>

<style>
    .table-scroll {
        overflow-x: auto;
    }

    table {
        width: 100%;
        min-width: 30rem;
        border-collapse: collapse;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius);
        font-size: 15px;
    }

    thead th:first-child {
        border-top-left-radius: 5px;
    }

    thead th:last-child {
        border-top-right-radius: 5px;
    }

    tbody tr:last-child td:first-child {
        border-bottom-left-radius: 5px;
    }

    tbody tr:last-child td:last-child {
        border-bottom-right-radius: 5px;
    }

    th {
        background: rgba(250, 224, 183, 0.4);
        color: var(--gray-600);
        font-size: 13px;
        font-weight: 500;
        text-align: left;
        padding: 10px 16px;
    }

    th.num {
        text-align: right;
    }

    td {
        padding: 12px 16px;
        border-top: 1px solid var(--gray-200);
        vertical-align: middle;
    }

    tbody tr:first-child td {
        border-top: 0;
    }

    .fork-name {
        font-family: var(--font-mono);
        font-size: 15px;
        color: var(--ink);
        text-decoration: none;
    }

    .fork-name:hover {
        color: var(--coral);
        text-decoration: none;
    }

    .footnote-mark {
        font-size: 11px;
        margin-left: 2px;
    }

    .mirror-tag {
        display: inline-block;
        margin-left: 8px;
        padding: 1px 6px;
        border-radius: 4px;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--gray-600);
        background: rgba(250, 224, 183, 0.4);
        vertical-align: 1px;
    }

    td.num {
        font-family: var(--font-mono);
        color: var(--gray-600);
        font-variant-numeric: tabular-nums;
        text-align: right;
    }

    .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 500;
        white-space: nowrap;
    }

    a.badge:hover {
        text-decoration: none;
        filter: brightness(1.08);
    }

    .badge-published {
        background: rgba(239, 78, 40, 0.12);
        color: var(--rust);
    }

    .badge-unpublished {
        background: var(--gray-200);
        color: var(--gray-600);
    }

    .badge-pending {
        background: rgba(168, 98, 20, 0.12);
        color: var(--amber);
    }

    .badge-outdated {
        background: rgba(168, 98, 20, 0.12);
        color: var(--amber);
    }

    .table-footnote,
    .table-note {
        margin: 12px 0 0;
        font-size: 13px;
        color: var(--gray-600);
    }

    /* Narrow screens: stack each row as a card, column name above each cell. */
    @media (max-width: 40rem) {
        .table-scroll {
            overflow: visible;
        }

        table {
            min-width: 0;
            border: 0;
        }

        thead {
            display: none;
        }

        tbody,
        tr {
            display: block;
        }

        tr {
            margin: 0 0 16px;
            padding: 0 16px 12px;
            border: 1px solid var(--gray-200);
            border-radius: var(--radius);
        }

        tr:last-child {
            margin-bottom: 0;
        }

        td {
            display: block;
            border: 0;
            padding: 12px 0 0;
        }

        td.num {
            text-align: left;
        }

        td[data-label]::before {
            content: attr(data-label);
            display: block;
            margin-bottom: 2px;
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-600);
        }
    }
</style>
