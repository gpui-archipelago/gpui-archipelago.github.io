---
// Forks at a glance — the data lives in the Manifest (src/data/projects.json)
// under the "Forks" category, so "add your fork" is a one-file change.
// Star/fork counts are manually maintained there too; consider fetching them
// from the GitHub API at build time if you want them to stay current.
import manifest from "../data/projects.json";
import CrateStatusBadge from "./CrateStatusBadge.astro";
import MaintenanceDot from "./MaintenanceDot.astro";
import type { MaintenanceState } from "../data/fork-status";

interface Fork {
    name: string;
    category: string;
    url: string;
    description: string;
    stars?: number;
    forks?: number;
    crateStatus: "published" | "unpublished" | "pending" | "outdated";
    /** crates.io page for the crate, when one exists (badge becomes a link). */
    crateUrl?: string;
    /** Small label pill next to the name, e.g. "upstream mirror". */
    tag?: string;
    /** Maintenance signal (design system §4.1a); absent = no flagged concern. */
    maintenance?: MaintenanceState;
    /** Row carries a footnote marker (see the note under the table). */
    footnote?: boolean;
}

const forks = (manifest.projects as Fork[]).filter(
    (fork) => fork.category === "Forks",
);
---

<div class="table-scroll">
    <table class="min-w-120 max-sm:min-w-0">
        <thead>
            <tr>
                <th scope="col">Fork</th>
                <th scope="col" class="num">Stars</th>
                <th scope="col" class="num">Forks</th>
                <th scope="col">Crate</th>
            </tr>
        </thead>
        <tbody>
            {
                forks.map((fork) => (
                    // The row is the hover/focus group: on either trigger the
                    // sand background (shared table.css) and the name's rust
                    // deepen together — the comparison table's single
                    // highest-weight interactive moment (design system §4.2).
                    <tr class="group">
                        <td data-label="Fork">
                            <a
                                class="font-mono text-code text-content no-underline group-hover:text-on-action group-focus-within:text-on-action"
                                href={fork.url}
                            >
                                {fork.name}
                            </a>
                            {fork.maintenance && (
                                <MaintenanceDot state={fork.maintenance} />
                            )}
                            {fork.tag && (
                                <span class="ml-2 inline-block rounded-sm bg-surface-warm px-1.5 py-px align-[1px] font-mono text-[11px] text-content-muted">
                                    {fork.tag}
                                </span>
                            )}
                        </td>
                        <td class="num" data-label="Stars">
                            {fork.stars?.toLocaleString("en-US") ?? "—"}
                        </td>
                        <td class="num" data-label="Forks">
                            {fork.forks?.toLocaleString("en-US") ?? "—"}
                        </td>
                        <td data-label="Crate">
                            <CrateStatusBadge
                                status={fork.crateStatus}
                                href={fork.crateUrl}
                                footnote={fork.footnote}
                            />
                        </td>
                    </tr>
                ))
            }
        </tbody>
    </table>
</div>
<p class="table-footnote">
    † The official <code>gpui</code> crate on crates.io is months behind upstream.
    For current upstream crates, use <a
        href="https://crates.io/crates/gpui-unofficial">gpui-unofficial</a
    > — an automated mirror of upstream Zed.
</p>
<p class="table-note">
    Star and fork counts are manually maintained in the Manifest — help keep
    them current.
</p>
