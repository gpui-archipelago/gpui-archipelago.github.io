---
// Gocar — Commands. The tool's whole surface, one line each, then the same
// list again as prose grouped by what you are doing when you reach for it.
// The groups are the toolchain's own four stages, and the table follows them
// so it reads top to bottom as the sections below.
//
// Where a study measured a command's behaviour the row links it; the handful
// no published study covers carry no link rather than a borrowed one.
import Layout from "../../layouts/Layout.astro";
import GocarNav from "../../components/GocarNav.astro";
import PageHeader from "../../components/PageHeader.astro";
import { GOCAR_COMMANDS, GOCAR_GROUPS } from "../../data/gocar";
---

<Layout
    siteNav={false}
    title="Commands — Gocar — gpui-archipelago"
    description="The whole cargo gocar command surface, and where each behaviour was measured."
>
    <GocarNav />

    <PageHeader
        title="Commands"
        meta="The whole surface — and where each behaviour was measured"
    />

    <section class="section border-b border-border-divider last:border-b-0">
        <div class="content">
            <div class="table-scroll">
                <table class="min-w-144 max-sm:min-w-0">
                    <thead>
                        <tr>
                            <th scope="col" class="w-[40%]">
                                Command
                            </th>
                            <th scope="col">What it does</th>
                            <th scope="col" class="w-[20%]">
                                Measured in
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        {GOCAR_COMMANDS.map((command) => (
                            <tr>
                                <td
                                    class="font-mono text-code"
                                    data-label="Command"
                                >
                                    {command.line}
                                </td>
                                <td data-label="What it does">
                                    {command.what}
                                </td>
                                <td data-label="Measured in">
                                    {command.evidence ? (
                                        <a href={command.evidence.href}>
                                            {command.evidence.label}
                                        </a>
                                    ) : (
                                        <span class="text-content-muted">
                                            —
                                        </span>
                                    )}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <p class="table-note">
                The studies cover the commands whose behaviour was measured
                against real crates.io artifacts; the rest carry no link rather
                than a borrowed one. The cited docs open in the map's reader,
                and <code>cargo gocar --help</code> is the authority for the
                whole surface, flags and options included.
            </p>
        </div>
    </section>

    {GOCAR_GROUPS.map((group) => (
        <section class="section border-b border-border-divider last:border-b-0">
            <div class="content">
                <h2 class="mb-8 text-h1 font-semibold tracking-[-0.01em] leading-tight">
                    {group.title}
                </h2>
                <div class="prose">
                    {GOCAR_COMMANDS.filter((c) => c.group === group.id).map(
                        (command) => (
                            <>
                                <h3 class="font-mono">{command.line}</h3>
                                <p>{command.details}</p>
                            </>
                        ),
                    )}
                </div>
            </div>
        </section>
    ))}
</Layout>
