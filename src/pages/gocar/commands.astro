---
// Gocar — Commands. The subcommands the Fork Map's own views name, each with
// where its behaviour was measured, then the same list again as prose: what
// each one is for, grouped by what you are doing when you reach for it. The
// tool's --help is the authority for the full surface; this is the slice the
// map and its studies actually exercise.
import Layout from "../../layouts/Layout.astro";
import GocarNav from "../../components/GocarNav.astro";
import PageHeader from "../../components/PageHeader.astro";
import { GOCAR_COMMANDS, GOCAR_GROUPS } from "../../data/gocar";
---

<Layout
    siteNav={false}
    title="Commands — Gocar — gpui-archipelago"
    description="The Gocar subcommands the fork map names, and the study each behaviour was measured in."
>
    <GocarNav />

    <PageHeader
        title="Commands"
        meta="The subcommands the Fork Map names — and where each was measured"
    />

    <section class="section border-b border-border-divider last:border-b-0">
        <div class="content">
            <div class="table-scroll">
                <table class="min-w-144 max-sm:min-w-0">
                    <thead>
                        <tr>
                            <th scope="col" class="w-[34%]">
                                Command
                            </th>
                            <th scope="col">What it does</th>
                            <th scope="col">Measured in</th>
                        </tr>
                    </thead>
                    <tbody>
                        {GOCAR_COMMANDS.map((command) => (
                            <tr>
                                <td
                                    class="font-mono text-code"
                                    data-label="Command"
                                >
                                    {command.line}
                                </td>
                                <td data-label="What it does">
                                    {command.what}
                                </td>
                                <td data-label="Measured in">
                                    <a href={command.evidence.href}>
                                        {command.evidence.label}
                                    </a>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <p class="table-note">
                The docs each one cites open in the map's reader.
                <code>cargo gocar --help</code> is the authority for the whole
                surface, flags and options included.
            </p>
        </div>
    </section>

    {GOCAR_GROUPS.map((group) => (
        <section class="section border-b border-border-divider last:border-b-0">
            <div class="content">
                <h2 class="mb-8 text-h1 font-semibold tracking-[-0.01em] leading-tight">
                    {group.title}
                </h2>
                <div class="prose">
                    {GOCAR_COMMANDS.filter((c) => c.group === group.id).map(
                        (command) => (
                            <>
                                <h3 class="font-mono">{command.line}</h3>
                                <p>{command.details}</p>
                            </>
                        ),
                    )}
                </div>
            </div>
        </section>
    ))}
</Layout>
