---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import newsArt from "../../assets/news.webp";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("news");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<Layout title={post.data.title} description={post.data.description}>
    <PageHeader
        title={post.data.title}
        meta={formatDate(post.data.date)}
        tags={post.data.tags}
        variant="sand"
    >
        <a
            class="text-content-muted no-underline hover:text-action"
            href="/news/"
            slot="kicker">news</a
        >
        <img
            class="header-art"
            src={newsArt.src}
            width={newsArt.width}
            height={newsArt.height}
            alt=""
            aria-hidden="true"
            decoding="async"
        />
    </PageHeader>

    {
        /* Prose typography and tables come from the shared stylesheets; the
        article wrapper only adds vertical padding around the content. */
    }
    <article class="prose py-8">
        <div class="content">
            <Content />
        </div>
    </article>
</Layout>

<style>
    /* The illustration anchors to the content column: its right edge lines up
       with the content edge, inside the container's 24px inline padding. It
       stays fully visible (square, no crop); the radial vignette dissolves the
       sky-blue box into the band so it reads as a soft shape, not a sticker.
       The band itself and the copy clearance live in PageHeader (sand). */
    .header-art {
        position: absolute;
        top: 50%;
        right: 24px;
        transform: translateY(-50%);
        /* Fixed square sized to always fit inside the content column's height
           (the meta always wraps to ≥2 lines, making the container ≥ ~126px),
           so the art never sticks out past the container's top or bottom edge
           and the centering stays symmetric. */
        width: 8rem;
        height: 8rem;
        object-fit: cover;
        opacity: 0.9;
        z-index: 0;
        /* Radial vignette: the fade starts earlier (40%) so it dissolves over
           a longer span and no ellipse ring is visible, and the center is
           biased slightly down so the sand stays visible deeper (tying into
           the band's lower edge) while the sky fades away at the top. */
        -webkit-mask-image: radial-gradient(
            ellipse 70% 70% at 50% 55%,
            black 40%,
            transparent 100%
        );
        mask-image: radial-gradient(
            ellipse 70% 70% at 50% 55%,
            black 40%,
            transparent 100%
        );
    }

    @media (max-width: 40rem) {
        .header-art {
            opacity: 0.85;
        }
    }
</style>
