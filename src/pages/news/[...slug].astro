---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("news");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<Layout title={post.data.title} description={post.data.description}>
    <PageHeader title={post.data.title} meta={formatDate(post.data.date)}>
        <a href="/news/" slot="kicker">news</a>
    </PageHeader>

    <article class="prose">
        <div class="container">
            <Content />
        </div>
    </article>
</Layout>

<style>
    /* Prose typography and tables come from the shared stylesheets; the
       article wrapper only adds vertical padding around the content. */
    article.prose {
        padding-block: var(--space-lg);
    }
</style>
