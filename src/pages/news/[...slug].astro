---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const posts = await getCollection("news");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<Layout title={post.data.title} description={post.data.description}>
    <div class="page-header">
        <div class="container">
            <p class="kicker"><a href="/news/">news</a></p>
            <h1>{post.data.title}</h1>
            <p class="meta">{formatDate(post.data.date)}</p>
        </div>
    </div>

    <article class="prose">
        <div class="container">
            <Content />
        </div>
    </article>
</Layout>

<style>
    .page-header {
        padding-block: 64px 32px;
        border-bottom: 1px solid rgba(55, 143, 189, 0.35);
    }

    .kicker {
        margin: 0 0 12px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--gray-600);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .kicker a {
        color: var(--gray-600);
        text-decoration: none;
    }

    .kicker a:hover {
        color: var(--coral);
        text-decoration: none;
    }

    .page-header h1 {
        margin: 0;
        font-size: 40px;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.2;
    }

    .meta {
        margin: 8px 0 0;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--gray-600);
    }
</style>

<!-- Rendered markdown needs unscoped rules to match its generated elements. -->
<style is:global>
    .prose {
        padding-block: 32px;
    }

    .prose > :first-child {
        margin-top: 0;
    }

    .prose p {
        margin: 0 0 20px;
    }

    .prose h2 {
        margin: 48px 0 16px;
        font-size: 32px;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.25;
    }

    .prose h3 {
        margin: 32px 0 12px;
        font-size: 20px;
        font-weight: 500;
        line-height: 1.3;
    }

    .prose ul,
    .prose ol {
        margin: 0 0 24px;
        padding-left: 1.4em;
    }

    .prose li {
        margin-bottom: 12px;
    }

    .prose table {
        display: block;
        width: 100%;
        min-width: 32rem;
        overflow-x: auto;
        border-collapse: collapse;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius);
        font-size: 15px;
        margin: 0 0 24px;
    }

    .prose thead th:first-child {
        border-top-left-radius: 5px;
    }

    .prose thead th:last-child {
        border-top-right-radius: 5px;
    }

    .prose tbody tr:last-child td:first-child {
        border-bottom-left-radius: 5px;
    }

    .prose tbody tr:last-child td:last-child {
        border-bottom-right-radius: 5px;
    }

    .prose th {
        background: rgba(250, 224, 183, 0.4);
        color: var(--gray-600);
        font-size: 13px;
        font-weight: 500;
        text-align: left;
        padding: 10px 16px;
    }

    .prose td {
        padding: 12px 16px;
        border-top: 1px solid var(--gray-200);
        vertical-align: top;
    }

    .prose tbody tr:first-child td {
        border-top: 0;
    }

    /* Narrow screens: stack each row as a card, column name above each cell. */
    @media (max-width: 40rem) {
        .prose table {
            min-width: 0;
            border: 0;
        }

        .prose thead {
            display: none;
        }

        .prose tbody,
        .prose tr {
            display: block;
        }

        .prose tr {
            margin: 0 0 16px;
            padding: 0 16px 12px;
            border: 1px solid var(--gray-200);
            border-radius: var(--radius);
        }

        .prose tr:last-child {
            margin-bottom: 0;
        }

        .prose td {
            display: block;
            border: 0;
            padding: 12px 0 0;
        }

        .prose td[data-label]::before {
            content: attr(data-label);
            display: block;
            margin-bottom: 2px;
            font-size: 13px;
            font-weight: 500;
            color: var(--gray-600);
        }
    }
</style>
