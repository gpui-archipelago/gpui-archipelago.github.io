---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("news")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<Layout
    title="News — gpui-archipelago"
    description="Monthly digests of what’s happening across the GPUI ecosystem."
>
    <PageHeader
        kicker="news"
        title="News"
        meta="Monthly digests of the GPUI ecosystem."
    />

    <section class="section">
        <div class="container">
            {
                posts.length === 0 ? (
                    <p class="empty">No posts yet.</p>
                ) : (
                    <ul class="post-list">
                        {posts.map((post) => (
                            <li>
                                <a
                                    class="post-title"
                                    href={`/news/${post.id}/`}
                                >
                                    {post.data.title}
                                </a>
                                <span class="post-date">
                                    {formatDate(post.data.date)}
                                </span>
                                <p class="post-excerpt">
                                    {post.data.description}
                                </p>
                            </li>
                        ))}
                    </ul>
                )
            }
        </div>
    </section>
</Layout>

<style>
    .empty {
        margin: 0;
        color: var(--gray-600);
    }

    .post-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .post-list li {
        padding-bottom: 24px;
        margin-bottom: 24px;
        border-bottom: 1px solid var(--gray-200);
    }

    .post-list li:last-child {
        padding-bottom: 0;
        margin-bottom: 0;
        border-bottom: 0;
    }

    .post-title {
        font-size: var(--type-h3);
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
    }

    .post-title:hover {
        color: var(--coral);
        text-decoration: none;
    }

    .post-date {
        margin-left: 8px;
        font-family: var(--font-mono);
        font-size: var(--type-small);
        color: var(--gray-600);
    }

    .post-excerpt {
        margin: 4px 0 0;
    }
</style>
