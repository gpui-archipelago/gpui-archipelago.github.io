---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostTags from "../../components/PostTags.astro";
import newsArt from "../../assets/news.webp";
import { getCollection } from "astro:content";

const posts = (await getCollection("news")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<Layout
    title="News — gpui-archipelago"
    description="Digests and overviews from across the GPUI ecosystem."
>
    <PageHeader
        kicker="news"
        title="News"
        meta="Digests and overviews of the GPUI ecosystem."
        variant="sand"
    >
        <img
            class="header-art"
            src={newsArt.src}
            width={newsArt.width}
            height={newsArt.height}
            alt=""
            aria-hidden="true"
            decoding="async"
        />
    </PageHeader>

    <section class="section">
        <div class="content">
            {
                posts.length === 0 ? (
                    <p class="m-0 text-content-muted">No posts yet.</p>
                ) : (
                    <ul class="m-0 list-none p-0">
                        {posts.map((post) => (
                            <li class="mb-6 border-b border-border-subtle pb-6 last:mb-0 last:border-b-0 last:pb-0">
                                <a
                                    class="text-h3 font-medium text-content no-underline hover:text-action"
                                    href={`/news/${post.id}/`}
                                >
                                    {post.data.title}
                                </a>
                                <span class="ml-2 font-mono text-small text-content-muted">
                                    {formatDate(post.data.date)}
                                </span>
                                <PostTags tags={post.data.tags} />
                                <p class="mt-1">{post.data.description}</p>
                            </li>
                        ))}
                    </ul>
                )
            }
        </div>
    </section>
</Layout>

<style>
    /* The illustration anchors to the content column: its right edge lines up
       with the content edge, inside the container's 24px inline padding. It
       stays fully visible (square, no crop); the radial vignette dissolves the
       sky-blue box into the band so it reads as a soft shape, not a sticker.
       The band itself and the copy clearance live in PageHeader (sand). */
    .header-art {
        position: absolute;
        top: 50%;
        right: 24px;
        transform: translateY(-50%);
        /* Fixed square sized to always fit inside the content column's height
           (the meta always wraps to ≥2 lines, making the container ≥ ~126px),
           so the art never sticks out past the container's top or bottom edge
           and the centering stays symmetric. */
        width: 8rem;
        height: 8rem;
        object-fit: cover;
        opacity: 0.9;
        z-index: 0;
        /* Radial vignette: the fade starts earlier (40%) so it dissolves over
           a longer span and no ellipse ring is visible, and the center is
           biased slightly down so the sand stays visible deeper (tying into
           the band's lower edge) while the sky fades away at the top. */
        -webkit-mask-image: radial-gradient(
            ellipse 70% 70% at 50% 55%,
            black 40%,
            transparent 100%
        );
        mask-image: radial-gradient(
            ellipse 70% 70% at 50% 55%,
            black 40%,
            transparent 100%
        );
    }

    @media (max-width: 40rem) {
        .header-art {
            opacity: 0.85;
        }
    }
</style>
