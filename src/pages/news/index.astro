---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("news")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-US", { month: "long", year: "numeric" });
---

<Layout
    title="News — gpui-archipelago"
    description="Monthly digests of what’s happening across the GPUI ecosystem."
>
    <PageHeader
        kicker="news"
        title="News"
        meta="Monthly digests of the GPUI ecosystem."
    />

    <section class="section">
        <div class="content">
            {
                posts.length === 0 ? (
                    <p class="m-0 text-content-muted">No posts yet.</p>
                ) : (
                    <ul class="m-0 list-none p-0">
                        {posts.map((post) => (
                            <li class="mb-6 border-b border-border-subtle pb-6 last:mb-0 last:border-b-0 last:pb-0">
                                <a
                                    class="text-h3 font-medium text-content no-underline hover:text-action"
                                    href={`/news/${post.id}/`}
                                >
                                    {post.data.title}
                                </a>
                                <span class="ml-2 font-mono text-small text-content-muted">
                                    {formatDate(post.data.date)}
                                </span>
                                <p class="mt-1">{post.data.description}</p>
                            </li>
                        ))}
                    </ul>
                )
            }
        </div>
    </section>
</Layout>
