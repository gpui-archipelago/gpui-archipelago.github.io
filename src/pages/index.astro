---
import Layout from "../layouts/Layout.astro";
import ForksTable from "../components/ForksTable.astro";
import { getCollection } from "astro:content";

// Latest news post, shown as a teaser at the bottom of the page.
const latestNews = (await getCollection("news")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)[0];

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-US", { month: "long", year: "numeric" });

const issueFormat = `## The problem
Written from the perspective of someone who just hit this wall.
What did they try to do, and what went wrong?

## Why it exists upstream
A plain explanation of the Zed priorities or constraints behind
the gap. Give context, don't assign blame.

## How people currently solve it
Known approaches: forks, crates, workarounds, conventions.
For each one: what it solves, what it doesn't, who maintains it.

## What nobody has solved yet
The part that's still genuinely open.

## Common ground opportunity
Optional. A convention, interface, or spec that several forks
could adopt to stay compatible with each other.`;

// Lines starting with "#" are the template's structural markup; the rest is
// guidance text. They get distinct colors in the block (4.3 of the design
// system). Built as HTML here so the newlines survive into the <pre>.
const issueFormatHtml = issueFormat
    .split("\n")
    .map((text) => {
        const cls = text.startsWith("#") ? "tmpl-head" : "tmpl-body";
        return `<span class="${cls}">${text}\n</span>`;
    })
    .join("");

const introForks = [
    {
        name: "gpui-unofficial",
        url: "https://github.com/iamnbutler/gpui-unofficial",
        description:
            "publishes up-to-date crates on crates.io, which covers distribution. Currently needs a maintainer.",
    },
    {
        name: "gpui-ce",
        url: "https://github.com/gpui-ce/gpui-ce",
        description:
            "a semi-official community fork aimed at governance, still working out where it’s headed.",
    },
    {
        name: "Kael",
        url: "https://github.com/Augani/kael",
        description:
            "forked from GPUI direct; selectively tracks upstream while building out general-purpose features (gradients, webviews, form controls, component library).",
    },
    {
        name: "WGPUI",
        url: "https://github.com/Far-Beyond-Pulsar/WGPUI",
        // Static trusted markup (defined above in this file); <code> keeps the
        // WgpuSurface identifier in monospace per the data/prose split.
        description:
            "a fork of gpui-ce that swaps the rendering/windowing backend for wgpu + winit. Unified code path across Windows, macOS, Linux, and WebAssembly. <code>WgpuSurface</code> lets you embed raw wgpu render passes (3D, game engines, custom shaders, anything) directly in your UI tree, making WGPUI suitable as a shell for 3D applications and mixed-mode interfaces.",
    },
];
---

<Layout
    title="gpui-archipelago"
    description="A community-maintained space for anyone building with GPUI outside of Zed. Every fork is an island — there’s no mainland, so the islands have to find each other."
>
    <section class="hero">
        <div class="container">
            <h1>gpui-archipelago</h1>
            <p class="aka">(aka GPUI-lago — “jee pyu ay la go”)</p>
            <blockquote>
                Every fork is an island. There’s no mainland and no one’s
                building one, so the islands have to find each other. Here they
                can.
            </blockquote>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="prose">
                <p>
                    Ideally, Zed would have published GPUI as a stable,
                    versioned crate, but that didn’t happen. Various people
                    forked it instead, and each fork ended up solving a
                    different part of the problem:
                </p>
            </div>
            <ul class="fork-list">
                {
                    introForks.map((fork) => (
                        <li>
                            <a class="fork-name" href={fork.url}>
                                {fork.name}
                            </a>
                            — <span set:html={fork.description} />
                        </li>
                    ))
                }
            </ul>
            <div class="prose">
                <p>
                    Meanwhile people keep turning up across GitHub issues,
                    Discord, and Reddit threads with similar frustrations across
                    these multiple projects.
                </p>
            </div>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <h2>What this is</h2>
            <div class="prose">
                <p>
                    <strong
                        ><a href="https://github.com/gpui-archipelago"
                            >gpui-archipelago</a
                        ></strong
                    > is a community-maintained space for anyone building with GPUI
                    outside of Zed. Maybe you run your own fork, maybe you depend
                    on someone else’s, maybe you want to ship something on top of
                    GPUI and minimize your chances of encountering unnecessary instability
                    and breakage.
                </p>
                <p>
                    The goal is not to pick a winner, but to understand the
                    landscape: what each approach solves, what it doesn’t, and
                    where common ground might exist across forks.
                </p>
            </div>
        </div>
    </section>

    <section id="forks" class="section">
        <div class="container">
            <h2>Forks at a glance</h2>
            <ForksTable />
        </div>
    </section>

    <section id="problems" class="section">
        <div class="container">
            <h2>Two kinds of problems</h2>
            <div class="problem-split">
                <div class="problem">
                    <h3>Ecosystem problems</h3>
                    <p>
                        Problems with how GPUI presents itself as a software
                        project: distribution, stability, versioning, docs,
                        guides for getting started at all. These are usually
                        fixable without touching GPUI source code.
                    </p>
                </div>
                <div class="problem">
                    <h3>Capability problems</h3>
                    <p>
                        Problems with what GPUI can do: missing elements,
                        missing escape hatches, missing points where the API can
                        be extended. These need code changes, and different
                        forks may make those changes in incompatible ways. This
                        is where a shared spec is useful.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section id="issues" class="section">
        <div class="container">
            <h2>How issues are structured</h2>
            <div class="prose">
                <p>Each issue lives in <code>issues/</code>. The format:</p>
            </div>
            <div class="issue-block">
                <span class="block-label">issue template</span>
                <pre
                    class="issue-format"><code set:html={issueFormatHtml} /></pre>
            </div>
        </div>
    </section>

    <section id="contribute" class="section">
        <div class="container">
            <h2>How to contribute</h2>
            <ul class="contribute-list">
                <li>
                    <strong>Add an issue</strong> — open a PR with a new file in <code
                        >issues/</code
                    >. Partial drafts and LLM-generated text are fine, just keep
                    it reasonable and concise.
                </li>
                <li>
                    <strong>Add an approach</strong> — know how a fork handles an
                    existing issue? Add it.
                </li>
                <li>
                    <strong>Correct something</strong> — wrong, stale, or unfair?
                    Open an issue or PR.
                </li>
                <li>
                    <strong>Add your fork</strong> — see the <a href="#forks"
                        >Forks table</a
                    > above. Any fork is welcome, however immature.
                </li>
                <li>
                    <strong>Share your experience</strong> — started a fork, abandoned
                    one, got burned and learned from it? Write it down here.
                </li>
            </ul>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <h2>Where this comes from</h2>
            <div class="prose">
                <p>
                    I started this <a href="https://github.com/gpui-archipelago"
                        >repo</a
                    > after trying not to fork, failing to use upstream as-is, and
                    picking up a few things along the way. So yes, there’s a bias.
                    Contributions from the other islands are what would keep this
                    from being one person’s opinion.
                </p>
            </div>
        </div>
    </section>

    <section class="section status-section">
        <div class="container">
            <h2>Status</h2>
            <p class="status-line">Still extremely alpha.</p>
        </div>
    </section>

    {
        latestNews && (
            <section class="section news-section">
                <div class="container">
                    <h2>News</h2>
                    <ul class="news-list">
                        <li>
                            <a
                                class="news-title"
                                href={`/news/${latestNews.id}/`}
                            >
                                {latestNews.data.title}
                            </a>
                            <span class="news-date">
                                {formatDate(latestNews.data.date)}
                            </span>
                            <p>{latestNews.data.description}</p>
                        </li>
                    </ul>
                </div>
            </section>
        )
    }
</Layout>

<style>
    /* ---------- Hero ---------- */

    .hero {
        padding-block: 64px 32px;
        border-bottom: 1px solid rgba(55, 143, 189, 0.35);
    }

    .hero h1 {
        margin: 0;
        font-size: 40px;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.2;
    }

    .aka {
        margin: 8px 0 0;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--gray-600);
    }

    .hero blockquote {
        margin: 24px 0 0;
        padding-left: 16px;
        border-left: 2px solid var(--ocean);
    }

    /* ---------- Sections ---------- */

    .section {
        padding-block: 32px;
        border-bottom: 1px solid rgba(55, 143, 189, 0.35);
    }

    .section:last-of-type {
        border-bottom: 0;
    }

    /* ---------- News ---------- */

    .news-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .news-list li {
        margin-bottom: 20px;
    }

    .news-list li:last-child {
        margin-bottom: 0;
    }

    .news-title {
        font-size: 20px;
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
    }

    .news-title:hover {
        color: var(--coral);
        text-decoration: none;
    }

    .news-date {
        margin-left: 8px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--gray-600);
    }

    .news-list p {
        margin: 4px 0 0;
    }

    .section h2 {
        margin: 0 0 32px;
        font-size: 32px;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.25;
    }

    [id] {
        scroll-margin-top: 88px;
    }

    /* ---------- Prose ---------- */

    .prose p {
        margin: 0;
    }

    .prose p + p {
        margin-top: 20px;
    }

    /* ---------- Intro fork list ---------- */

    .fork-list {
        list-style: none;
        margin: 20px 0;
        padding: 0;
    }

    .fork-list li {
        margin-bottom: 20px;
    }

    .fork-list li:last-child {
        margin-bottom: 0;
    }

    .fork-name {
        font-family: var(--font-mono);
        font-size: 15px;
        font-weight: 600;
        color: var(--ink);
        text-decoration: none;
    }

    .fork-name:hover {
        color: var(--coral);
        text-decoration: none;
    }

    /* ---------- Two-problem split (4.4) ---------- */

    .problem-split {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 48px;
    }

    .problem h3 {
        margin: 0 0 8px;
        font-size: 20px;
        font-weight: 500;
        line-height: 1.3;
    }

    .problem p {
        margin: 0;
    }

    @media (max-width: 40rem) {
        .problem-split {
            grid-template-columns: 1fr;
            gap: 32px;
        }
    }

    /* ---------- Issue template block (4.3) ---------- */

    .block-label {
        display: block;
        margin-bottom: 8px;
        font-size: 13px;
        color: var(--gray-600);
    }

    .issue-format {
        margin: 0;
        padding: 20px 24px;
        background: #fff8ed;
        border: 1px solid var(--gray-200);
        border-radius: var(--radius);
        font-family: var(--font-mono);
        font-size: 15px;
        line-height: 1.5;
        overflow-x: auto;
    }

    .tmpl-head {
        color: var(--ink);
        font-weight: 600;
    }

    .tmpl-body {
        color: var(--gray-600);
    }

    /* ---------- Contribute ---------- */

    .contribute-list {
        margin: 0;
        padding-left: 1.4em;
    }

    .contribute-list li {
        margin-bottom: 12px;
    }

    .contribute-list li:last-child {
        margin-bottom: 0;
    }

    /* ---------- Status ---------- */

    .status-line {
        margin: 0;
    }
</style>
