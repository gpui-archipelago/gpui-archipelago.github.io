---
import Layout from "../layouts/Layout.astro";
import ForksTable from "../components/ForksTable.astro";
import PageHeader from "../components/PageHeader.astro";
import ProblemSplit from "../components/ProblemSplit.astro";
import IssueTemplate from "../components/IssueTemplate.astro";
import heroArt from "../assets/hero.webp";
import { getCollection } from "astro:content";

// Latest news post, shown as a teaser at the bottom of the page.
const latestNews = (await getCollection("news")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)[0];

const formatDate = (date: Date) =>
    date.toLocaleDateString("en-US", { month: "long", year: "numeric" });

const introForks = [
    {
        name: "gpui-unofficial",
        url: "https://github.com/iamnbutler/gpui-unofficial",
        description:
            "publishes up-to-date crates on crates.io, which covers distribution. Currently needs a maintainer.",
    },
    {
        name: "gpui-ce",
        url: "https://github.com/gpui-ce/gpui-ce",
        description:
            "a semi-official community fork aimed at governance, still working out where it’s headed.",
    },
    {
        name: "Kael",
        url: "https://github.com/Augani/kael",
        description:
            "forked from GPUI direct; selectively tracks upstream while building out general-purpose features (gradients, webviews, form controls, component library).",
    },
    {
        name: "WGPUI",
        url: "https://github.com/Far-Beyond-Pulsar/WGPUI",
        // Static trusted markup (defined above in this file); <code> keeps the
        // WgpuSurface identifier in monospace per the data/prose split.
        description:
            "a fork of gpui-ce that swaps the rendering/windowing backend for wgpu + winit. Unified code path across Windows, macOS, Linux, and WebAssembly. <code>WgpuSurface</code> lets you embed raw wgpu render passes (3D, game engines, custom shaders, anything) directly in your UI tree, making WGPUI suitable as a shell for 3D applications and mixed-mode interfaces.",
    },
];

// Two-problem split (design system §4.4) — the content already provides these
// definitions precisely; the component just lays them out side by side.
const problemSplit = [
    {
        heading: "Ecosystem problems",
        body: "Problems with how GPUI presents itself as a software project: distribution, stability, versioning, docs, guides for getting started at all. These are usually fixable without touching GPUI source code.",
    },
    {
        heading: "Capability problems",
        body: "Problems with what GPUI can do: missing elements, missing escape hatches, missing points where the API can be extended. These need code changes, and different forks may make those changes in incompatible ways. This is where a shared spec is useful.",
    },
];
---

<Layout
    title="gpui-archipelago"
    description="A community-maintained space for anyone building with GPUI outside of Zed. Every fork is an island — there’s no mainland, so the islands have to find each other."
>
    <PageHeader
        title="gpui-archipelago"
        meta="(aka GPUI-lago — “jee pyu ay la go”)"
        variant="sand"
    >
        <blockquote
            class="relative z-10 mt-6 max-w-[calc(100%-12rem)] border-l-2 border-border-accent pl-4 max-sm:max-w-[calc(100%-8.5rem)]"
        >
            Every fork is an island. There’s no mainland and no one’s building
            one, so the islands have to find each other. Here they can.
        </blockquote>
        <img
            class="header-art"
            src={heroArt.src}
            width={heroArt.width}
            height={heroArt.height}
            alt=""
            aria-hidden="true"
            decoding="async"
        />
    </PageHeader>

    <section class="section border-b border-border-divider last:border-b-0">
        <div class="content">
            <div class="prose">
                <p>
                    Ideally, Zed would have published GPUI as a stable,
                    versioned crate, but that didn’t happen. Various people
                    forked it instead, and each fork ended up solving a
                    different part of the problem:
                </p>
            </div>
            <ul class="my-5 list-none space-y-5 p-0">
                {
                    introForks.map((fork) => (
                        <li>
                            <a
                                class="font-mono text-code font-semibold text-content no-underline hover:text-action"
                                href={fork.url}
                            >
                                {fork.name}
                            </a>
                            — <span set:html={fork.description} />
                        </li>
                    ))
                }
            </ul>
            <div class="prose">
                <p>
                    Meanwhile people keep turning up across GitHub issues,
                    Discord, and Reddit threads with similar frustrations across
                    these multiple projects.
                </p>
            </div>
        </div>
    </section>

    <section class="section border-b border-border-divider last:border-b-0">
        <div class="content">
            <h2
                class="mb-8 text-h1 font-semibold tracking-[-0.01em] leading-tight"
            >
                What this is
            </h2>
            <div class="prose">
                <p>
                    <strong
                        ><a href="https://github.com/gpui-archipelago"
                            >gpui-archipelago</a
                        ></strong
                    > is a community-maintained space for anyone building with GPUI
                    outside of Zed. Maybe you run your own fork, maybe you depend
                    on someone else’s, maybe you want to ship something on top of
                    GPUI and minimize your chances of encountering unnecessary instability
                    and breakage.
                </p>
                <p>
                    The goal is not to pick a winner, but to understand the
                    landscape: what each approach solves, what it doesn’t, and
                    where common ground might exist across forks.
                </p>
            </div>
        </div>
    </section>

    <section
        id="forks"
        class="section border-b border-border-divider last:border-b-0"
    >
        <div class="content">
            <h2
                class="mb-8 text-h1 font-semibold tracking-[-0.01em] leading-tight"
            >
                Forks at a glance
            </h2>
            <ForksTable />
        </div>
    </section>

    <section
        id="problems"
        class="section border-b border-border-divider last:border-b-0"
    >
        <div class="content">
            <h2
                class="mb-8 text-h1 font-semibold tracking-[-0.01em] leading-tight"
            >
                Two kinds of problems
            </h2>
            <ProblemSplit problems={problemSplit} />
        </div>
    </section>

    <section
        id="issues"
        class="section border-b border-border-divider last:border-b-0"
    >
        <div class="content">
            <h2
                class="mb-8 text-h1 font-semibold tracking-[-0.01em] leading-tight"
            >
                How issues are structured
            </h2>
            <div class="prose">
                <p>Each issue lives in <code>issues/</code>. The format:</p>
            </div>
            <IssueTemplate />
        </div>
    </section>

    <section
        id="contribute"
        class="section border-b border-border-divider last:border-b-0"
    >
        <div class="content">
            <h2
                class="mb-8 text-h1 font-semibold tracking-[-0.01em] leading-tight"
            >
                How to contribute
            </h2>
            <ul class="m-0 list-disc space-y-3 pl-[1.4em]">
                <li>
                    <strong>Add an issue</strong> — open a PR with a new file in
                    <code>issues/</code>. Partial drafts and LLM-generated text
                    are fine, just keep it reasonable and concise.
                </li>
                <li>
                    <strong>Add an approach</strong> — know how a fork handles an
                    existing issue? Add it.
                </li>
                <li>
                    <strong>Correct something</strong> — wrong, stale, or unfair?
                    Open an issue or PR.
                </li>
                <li>
                    <strong>Add your fork</strong> — see the
                    <a href="#forks">Forks table</a> above. Any fork is welcome, however
                    immature.
                </li>
                <li>
                    <strong>Add a project</strong> — the
                    <a href="/manifest/">Manifest</a> lists forks, apps, libraries,
                    tooling, and learning material built on GPUI. It isn’t limited
                    to crates.
                </li>
                <li>
                    <strong>Share your experience</strong> — started a fork, abandoned
                    one, got burned and learned from it? Write it down here, or come
                    tell us about it on
                    <a href="https://discord.gg/bcuR88Z8ku">Discord</a>.
                </li>
            </ul>
        </div>
    </section>

    <section class="section border-b border-border-divider last:border-b-0">
        <div class="content">
            <h2
                class="mb-8 text-h1 font-semibold tracking-[-0.01em] leading-tight"
            >
                Where this comes from
            </h2>
            <div class="prose">
                <p>
                    I started this
                    <a href="https://github.com/gpui-archipelago">repo</a> after trying
                    not to fork, failing to use upstream as-is, and picking up a few
                    things along the way. So yes, there’s a bias. Contributions from
                    the other islands are what would keep this from being one person’s
                    opinion.
                </p>
            </div>
        </div>
    </section>

    <section class="section border-b border-border-divider last:border-b-0">
        <div class="content">
            <h2
                class="mb-8 text-h1 font-semibold tracking-[-0.01em] leading-tight"
            >
                Status
            </h2>
            <p class="m-0">Still extremely alpha.</p>
        </div>
    </section>

    {
        latestNews && (
            <section class="section border-b border-border-divider last:border-b-0">
                <div class="content">
                    <h2 class="mb-8 text-h1 font-semibold tracking-[-0.01em] leading-tight">
                        News
                    </h2>
                    <ul class="m-0 list-none space-y-5 p-0">
                        <li>
                            <a
                                class="text-h3 font-medium text-content no-underline hover:text-action"
                                href={`/news/${latestNews.id}/`}
                            >
                                {latestNews.data.title}
                            </a>
                            <span class="ml-2 font-mono text-small text-content-muted">
                                {formatDate(latestNews.data.date)}
                            </span>
                            <p class="mt-1">{latestNews.data.description}</p>
                        </li>
                    </ul>
                </div>
            </section>
        )
    }
</Layout>

<style>
    /* The illustration anchors to the content column: its right edge lines up
       with the content edge, inside the container's 24px inline padding. It
       stays fully visible (square, no crop); the radial vignette dissolves the
       sky-blue box into the band so it reads as a soft shape, not a sticker.
       The band itself and the copy clearance live in PageHeader (sand). */
    .header-art {
        position: absolute;
        top: 50%;
        right: 24px;
        transform: translateY(-50%);
        /* Fixed square sized to always fit inside the content column's height
           (the meta always wraps to ≥2 lines, making the container ≥ ~126px),
           so the art never sticks out past the container's top or bottom edge
           and the centering stays symmetric. */
        width: 8rem;
        height: 8rem;
        object-fit: cover;
        opacity: 0.9;
        z-index: 0;
        /* Radial vignette: the fade starts earlier (40%) so it dissolves over
           a longer span and no ellipse ring is visible, and the center is
           biased slightly down so the sand stays visible deeper (tying into
           the band's lower edge) while the sky fades away at the top. */
        -webkit-mask-image: radial-gradient(
            ellipse 70% 70% at 50% 55%,
            black 40%,
            transparent 100%
        );
        mask-image: radial-gradient(
            ellipse 70% 70% at 50% 55%,
            black 40%,
            transparent 100%
        );
    }

    @media (max-width: 40rem) {
        .header-art {
            opacity: 0.85;
        }
    }
</style>
