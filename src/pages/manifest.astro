---
import Layout from "../layouts/Layout.astro";
import ManifestTable from "../components/ManifestTable.astro";
import manifestArt from "../assets/manifest.webp";
---

<Layout
    title="Manifest — gpui-archipelago"
    description="A community-maintained index of forks, apps, libraries, tooling, and learning material built downstream of the GPUI ecosystem."
>
    <div class="page-header">
        <div class="container">
            <img
                class="header-art"
                src={manifestArt.src}
                width={manifestArt.width}
                height={manifestArt.height}
                alt=""
                aria-hidden="true"
                decoding="async"
            />
            <div class="header-copy">
                <p class="kicker">manifest</p>
                <h1>Manifest</h1>
                <p class="meta">Projects shipped downstream of GPUI islands</p>
            </div>
        </div>
    </div>

    <section class="section">
        <div class="container">
            <div class="prose">
                <p>
                    The Manifest is a community-maintained index of things built
                    on or for the GPUI ecosystem: the forks themselves, apps,
                    component libraries, tools, and learning material. It isn’t
                    limited to cargo crates: if it ships downstream of one of
                    the islands, it belongs here.
                </p>
            </div>
            <ManifestTable />
        </div>
    </section>
</Layout>

<style>
    .page-header {
        position: relative;
        overflow: hidden;
        padding-block: 48px 48px;
        /* Symmetric fades: a thin sliver at the top melts the band out of the
           white site-header above, a matching sliver at the bottom melts it
           into the body. Both fades sit inside the 48px padding, so the copy
           and art rest on equal solid sand on both sides — no hard edges. */
        background: linear-gradient(
            to bottom,
            rgba(250, 224, 183, 0) 0%,
            rgba(250, 224, 183, 0.5) 20px,
            rgba(250, 224, 183, 0.5) calc(100% - 20px),
            rgba(250, 224, 183, 0) 100%
        );
    }

    /* The illustration anchors to the content column: its right edge lines up
       with the content edge, inside the container's 24px inline padding. It
       stays fully visible (square, no crop); the radial vignette dissolves the
       sky-blue box into the band so it reads as a soft shape, not a sticker. */
    .page-header .container {
        position: relative;
    }

    .header-art {
        position: absolute;
        top: 50%;
        right: 24px;
        transform: translateY(-50%);
        /* Fixed square sized to always fit inside the content column's height
           (the meta always wraps to ≥2 lines, making the container ≥ ~126px),
           so the art never sticks out past the container's top or bottom edge
           and the centering stays symmetric. */
        width: 8rem;
        height: 8rem;
        object-fit: cover;
        opacity: 0.9;
        z-index: 0;
        /* Radial vignette: the fade starts earlier (40%) so it dissolves over
           a longer span and no ellipse ring is visible, and the center is
           biased slightly down so the sand stays visible deeper (tying into
           the band's lower edge) while the sky fades away at the top. */
        -webkit-mask-image: radial-gradient(
            ellipse 70% 70% at 50% 55%,
            black 40%,
            transparent 100%
        );
        mask-image: radial-gradient(
            ellipse 70% 70% at 50% 55%,
            black 40%,
            transparent 100%
        );
    }

    /* Copy sits directly on the band — no panel — and stays clear of the
       illustration's corner at every width. */
    .header-copy {
        position: relative;
        z-index: 2;
        max-width: calc(100% - 12rem);
    }

    @media (max-width: 40rem) {
        .header-art {
            opacity: 0.85;
        }

        .header-copy {
            max-width: calc(100% - 8.5rem);
        }
    }

    .kicker {
        margin: 0 0 12px;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--gray-600);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .page-header h1 {
        margin: 0;
        font-size: 40px;
        font-weight: 600;
        letter-spacing: -0.01em;
        line-height: 1.2;
    }

    .meta {
        margin: 8px 0 0;
        font-family: var(--font-mono);
        font-size: 13px;
        color: var(--gray-600);
    }

    .section {
        padding-block: 32px;
    }

    .prose p {
        margin: 0 0 20px;
    }
</style>
