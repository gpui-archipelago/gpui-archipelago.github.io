---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    /**
     * Render the site's global nav. A section that is its own top-level chrome
     * passes `false` and renders its own header instead (`/gocar/`, the way the
     * Fork Map does): the site nav stays exactly as it is — it simply is not
     * that page's bar, so the section wears one header rather than two.
     */
    siteNav?: boolean;
}

const {
    title = "gpui-archipelago",
    description = "A community-maintained space for anyone building with GPUI outside of Zed. Every fork is an island — there’s no mainland, so the islands have to find each other.",
    siteNav = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#FFFFFF" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <title>{title}</title>
    </head>
    <body>
        {siteNav && <SiteHeader />}
        <main>
            <slot />
        </main>
        <SiteFooter />
    </body>
</html>
